# ============================================================
# NOXIS configuration. Copy to .env and fill in what you need.
# Nothing here is a real secret; every value is optional unless
# noted. The gateway starts with only Pollinations (keyless)
# enabled by default, so you can run NOXIS with zero API keys.
# ============================================================

# --- Core ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Gateway authentication ---
# Master key: full admin access. Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOXIS_MASTER_KEY=
# Comma-separated additional client keys (no admin access)
NOXIS_GATEWAY_KEYS=
# If true, requests without any Authorization header are allowed
# (NOT recommended in production; keeps NOXIS from becoming an open relay)
ALLOW_UNAUTHENTICATED=false

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./noxis.db
# Postgres example: postgresql+asyncpg://user:pass@localhost:5432/noxis

# --- Redis (optional, for distributed cache) ---
REDIS_URL=

# --- Cache ---
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_BACKEND=memory

# --- Request limits ---
MAX_REQUEST_BYTES=2000000
MAX_TOKENS_CEILING=32000
GATEWAY_RATE_LIMIT_PER_MIN=120
GATEWAY_MAX_CONCURRENCY=100

# --- Failover ---
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.5
BACKOFF_MAX_SECONDS=8.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30.0

# --- CORS ---
CORS_ALLOW_ORIGINS=*

# ============================================================
# API-key providers (all optional — enable only what you have
# legitimate, administrator-supplied credentials for)
# ============================================================
GROQ_API_KEY=
GROQ_ENABLED=false

CEREBRAS_API_KEY=
CEREBRAS_ENABLED=false

OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false

MISTRAL_API_KEY=
MISTRAL_ENABLED=false

GEMINI_API_KEY=
GEMINI_ENABLED=false

DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false

NVIDIA_API_KEY=
NVIDIA_ENABLED=false

COHERE_API_KEY=
COHERE_ENABLED=false

GITHUB_TOKEN=
GITHUB_MODELS_ENABLED=false

HF_TOKEN=
HUGGINGFACE_ENABLED=false

# ============================================================
# Keyless providers — genuinely public, unauthenticated,
# OpenAI-compatible endpoints. Verified for reachability and
# lack of auth at startup; marked UNAVAILABLE if that changes.
# Keyless does NOT mean unlimited — provider rate limits still
# apply and are tracked like any other provider.
# ============================================================
POLLINATIONS_ENABLED=true
POLLINATIONS_BASE_URL=https://text.pollinations.ai/v1

LLM7_ENABLED=false
LLM7_BASE_URL=https://api.llm7.io/v1

KEYLESSAI_ENABLED=false
KEYLESSAI_BASE_URL=https://keylessai.thryx.workers.dev/v1

AIRFORCE_ENABLED=false
AIRFORCE_BASE_URL=https://api.airforce/v1

OVH_AI_ENABLED=false
OVH_AI_BASE_URL=https://api.ovh.ai/v1
